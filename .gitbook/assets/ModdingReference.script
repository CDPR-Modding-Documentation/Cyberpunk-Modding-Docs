//////////////////////////////////////////////////////////////////////////
// 1.4. New Functions

//////////////////////////////////////////////////////////////////////////
// 1.4.1 Game instance Getter

function 1_4_1_GetGameInstanceAnywhere()
{
    // you can now Get the Game instance anywhere in scripts
    var gi : GameInstance = GetGameInstanceFromEngine();
    //this provide a way to get the game instance in cases where you wouldn't have access to it,
    //like if you do not have the player or a context.
}

